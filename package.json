{
  "name": "opendeck",
  "version": "1.6.0-claude.1",
  "description": "Editable PPTD presentation workflow for one active host model, with measured layout checks. Does not render slides or write PPTX.",
  "license": "MIT",
  "author": "Feida Wang",
  "homepage": "https://github.com/FeidaWang/OpenDeck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeidaWang/OpenDeck.git"
  },
  "bugs": {
    "url": "https://github.com/FeidaWang/OpenDeck/issues"
  },
  "keywords": [
    "ppt",
    "slides",
    "presentation",
    "pptd",
    "agent-skill",
    "codex",
    "claude-code",
    "cursor",
    "codebuddy",
    "layout"
  ],
  "type": "module",
  "bin": {
    "opendeck": "bin/opendeck.js"
  },
  "files": [
    "bin/",
    "plugin.json",
    "skills/opendeck/SKILL.md",
    "skills/opendeck/reference/",
    "skills/opendeck/references/",
    "skills/opendeck/scripts/",
    "skills/opendeck/config/",
    "skills/opendeck/agents/",
    "skills/opendeck/requirements*.txt",
    "README.md",
    "README_ZH.md",
    "LICENSE",
    "CHANGELOG.md",
    "CHANGELOG_ZH.md",
    "AGENTS.md",
    "examples/codex/",
    "theme.md",
    "theme_ZH.md",
    "!**/__pycache__/**",
    "!**/*.py[cod]",
    "!**/.pytest_cache/**",
    "!**/.DS_Store",
    "!**/_user_meta.json"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  }
}
