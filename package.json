{
  "name": "open-kimi-ppt-skill",
  "version": "1.5.0-claude.1",
  "description": "Editable PPTD presentation workflow for one active host model, with measured layout checks. Does not render slides or write PPTX.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Feida Wang",
  "homepage": "https://github.com/FeidaWang/OpenDeck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeidaWang/OpenDeck.git"
  },
  "bugs": {
    "url": "https://github.com/FeidaWang/OpenDeck/issues"
  },
  "keywords": [
    "ppt",
    "slides",
    "presentation",
    "pptd",
    "agent-skill",
    "codex",
    "claude-code",
    "cursor",
    "codebuddy",
    "layout"
  ],
  "type": "module",
  "bin": {
    "open-kimi-ppt-skill": "bin/open-kimi-ppt-skill.js"
  },
  "files": [
    "bin/",
    "plugin.json",
    "skills/open-kimi-ppt/SKILL.md",
    "skills/open-kimi-ppt/reference/",
    "skills/open-kimi-ppt/references/",
    "skills/open-kimi-ppt/scripts/",
    "skills/open-kimi-ppt/config/",
    "skills/open-kimi-ppt/agents/",
    "skills/open-kimi-ppt/requirements*.txt",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "LICENSES/",
    "NOTICE",
    "CHANGELOG.md",
    "CHANGELOG_EN.md",
    "AGENTS.md",
    "examples/codex/",
    "theme.md",
    "theme_EN.md",
    "!**/__pycache__/**",
    "!**/*.py[cod]",
    "!**/.pytest_cache/**",
    "!**/.DS_Store",
    "!**/_user_meta.json"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "contributors": [
    {
      "name": "binaryify",
      "url": "https://github.com/binaryify/open-kimi-ppt-skill"
    }
  ]
}
